{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outroladorpg",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "outro-lado-rpg-bryan",
    "MASTER_EMAIL": "bryanferreira2909@gmail.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/ws",
      "/health",
      "/socket.io/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLE_ROOMS",
        "class_name": "TableRoom"
      }
    ]
  },
  "exports": {
    "TableRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
